{
  "id": "app.bitchord.lossless-bridge",
  "name": "GT 20 Pro Hi-Res Music",
  "version": "1.0.1",
  "resources": ["search", "stream"],
  "allowDownloads": 1,
  "checkValidLossless": 0,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        {"label": "Hi-Res", "value": "studio"},
        {"label": "Lossless", "value": "lossless"},
        {"label": "High", "value": "high"},
        {"label": "Low", "value": "low"}
      ]
    },
    {
      "key": "prefer",
      "type": "select",
      "default": "studio",
      "options": [
        {"label": "Studio masters first", "value": "studio"},
        {"label": "Live and bootlegs first", "value": "live"}
      ]
    }
  ]
}
